# 셸 스크립트는 항상 LF 로 보관/체크아웃한다.
# 윈도우에서 커밋하더라도 CRLF 로 변질되지 않게 하여 Linux/git-bash 에서
# scripts/build.sh 등이 깨지지 않도록 보장한다.
*.sh    text eol=lf
*.bash  text eol=lf

# PowerShell 은 CRLF 가 자연스럽다.
*.ps1   text eol=crlf

# Go 소스/모듈 파일은 LF.
*.go    text eol=lf
go.mod  text eol=lf
go.sum  text eol=lf

# 빌드 산출물/바이너리는 바이너리로 취급(줄바꿈 변환 금지).
*.exe   binary
